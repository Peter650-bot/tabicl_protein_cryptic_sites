  "rationale": {
    "control": "the published 117 features; also the determinism gate against build/cv_scores/k64_train-fold-0.json",
    "esmnb": "8 A spatial mean of the 16 leading ESM components; the pLM block is the one family with no spatial pooling, and every pooled column in the project outranks its parent",
    "esmsup32_seqwin_esmnb": "the supervised block plus the two pooling families, pre-registered as a combination so it is not a post-hoc union of whatever won",
    "esmsup32": "32 fold-nested PLS components replace the 64 unsupervised PCs; SMALLER than the control at 85 features",
    "free_combo": "seqwin + pctx + prel, the union that costs nothing to build",
    "nbstat": "spread and extreme at 8 A plus a 12 A shell; a pocket is a patch, and the mean is the only shape statistic currently taken of it",
    "pctx": "protein-level aggregates broadcast to each row; every metric in the project is per protein, yet a row carries no protein context beyond chain_len",
    "prel": "within-protein rank and z; expected to fail -- rank costs ens_mean 0.776->0.767 and z 0.776->0.750 univariately",
    "seqwin": "5-residue backbone windows on the sequence-derived families; measured sign-free on train, cons_prob_self 0.625->0.651 and esm_pc01 0.564->0.616, while ens_mean falls 0.776->0.742 and is excluded",
    "trim": "drop the 24 ESM PCs at |AUC-0.5| <= 0.02 on train; the 'removing features' arm, expected null or negative"
  },
